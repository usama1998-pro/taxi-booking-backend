NODE_ENV=development
PORT=3000

# JWT (required in production). Example: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
# Optional access token lifetime (default 7d). Controls JWT `exp` and signin/signup `expires_in` / `expires_at`.
# JWT_EXPIRES_IN=7d

# Optional: printed on startup (defaults to http://localhost:{PORT})
APP_URL=http://localhost:3000

# Direct TCP URL for `pg` / Prisma adapter (postgresql:// or postgres:// only).
# If you use Prisma Accelerate, keep `DATABASE_URL` as prisma+postgres://… for tooling that supports it,
# and set DATABASE_DIRECT_URL (or rely on discrete DATABASE_* below) for the Nest app.
# DATABASE_URL=postgresql://taxi:taxi@localhost:5432/taxi_booking
# DATABASE_DIRECT_URL=postgresql://taxi:taxi@localhost:5432/taxi_booking
#
# Host vs Docker: compose maps host port DATABASE_PORT -> container 5432 (see docker-compose.yml).
# - API on your machine (npm run start:dev): DATABASE_HOST=localhost, DATABASE_PORT=<published host port>
# - API in Docker on taxi-booking-network: DATABASE_HOST=postgres, DATABASE_PORT=5432

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=taxi
DATABASE_PASSWORD=taxi
DATABASE_NAME=taxi_booking
