NODE_ENV=development
PORT=3000

# IANA timezone for Node (logs, toLocaleString, etc.). Barcelona uses Spain civil time.
TZ=Europe/Madrid

# JWT (required in production). Example: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
# Optional access token lifetime (default 7d). Controls JWT `exp` and signin/signup `expires_in` / `expires_at`.
# JWT_EXPIRES_IN=7d

# Optional: printed on startup (defaults to http://localhost:{PORT})
APP_URL=http://localhost:3000

# CORS: the API allows any browser origin (`origin: true`). Tighten before a public launch if needed.

# Direct TCP URL for Prisma CLI and `@prisma/adapter-mariadb` (mysql:// only).
# DATABASE_URL=mysql://taxi:taxi@localhost:3306/taxi_booking
# DATABASE_DIRECT_URL=mysql://taxi:taxi@localhost:3306/taxi_booking
#
# Host vs Docker: compose maps host port DATABASE_PORT -> container 3306 (see docker-compose.yml).
# - API on your machine (npm run start:dev): DATABASE_HOST=localhost, DATABASE_PORT=<published host port>
# - API in Docker on taxi-booking-network: DATABASE_HOST=mysql, DATABASE_PORT=3306
#
# Root password is only for the DB container / admin tools (see docker-compose MYSQL_ROOT_PASSWORD / DATABASE_ROOT_PASSWORD).

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=taxi
DATABASE_PASSWORD=taxi
DATABASE_NAME=taxi_booking
# DATABASE_ROOT_PASSWORD=taxi_root

# Shared hosting (e.g. Hostinger): lowers MariaDB pool size to reduce `max_connections_per_hour` usage.
# Or add `?connectionLimit=2` to your mysql URL instead.
# DATABASE_POOL_CONNECTION_LIMIT=2
#
# Remote / Hostinger-style MySQL (fixes "pool timeout … active=0 idle=0"):
# - Use the MySQL *hostname* from hPanel (often NOT your website domain).
# - hPanel → Databases → Remote MySQL: allow the public IP of the machine running this API.
# - Many hosts require TLS for external connections:
#   DATABASE_SSL=1
# - Optional TCP connect timeout (ms). If unset and DATABASE_SSL=1, defaults to 20000 in the URL:
#   DATABASE_CONNECT_TIMEOUT_MS=30000
# - If TLS fails on certificate verification (common on some shared hosts), only after DATABASE_SSL=1:
#   DATABASE_SSL_REJECT_UNAUTHORIZED=0
# - MySQL 8 `caching_sha2_password` from some networks:
#   DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=1

# Staff users: `npm run create-admin` sets `User.is_admin`. Answer "y" to also set `is_super_admin`
# (required to call POST/PATCH/DELETE `/admin/driver-verification-codes`). To promote an existing
# staff user: `npm run promote-super-admin`.

# Build/CI only: if the host runs `prisma generate` without any DATABASE_* / mysql URL, set to 1 so
# `prisma.config.ts` can load. Do not use when running `prisma migrate` against a real database.
# PRISMA_BUILD_SCHEMA_ONLY=1
