generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @default(uuid())
  fullName      String
  email         String    @unique
  phone         String    @unique
  password      String
  isAdmin       Boolean   @default(false) @map("is_admin")
  /** Staff-only. When true, may manage driver verification codes via admin APIs. */
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  tokenVersion  Int       @default(0) @map("token_version")
  driverProfile Driver?
  bookings      Booking[]
  createdAt     DateTime  @default(now())
}

enum InvoiceAddressKind {
  LOCATION
  AIRPORT
}

model Driver {
  id            String    @id @default(uuid())
  userId        String?   @unique @map("user_id")
  name          String
  email         String    @unique
  phone         String    @unique
  password      String
  photoUrl        String?
  ratingAverage   Float?
  ratingCount     Int       @default(0)
  isAvailable     Boolean   @default(true)
  isActive        Boolean   @default(true)
  tokenVersion  Int       @default(0) @map("token_version")
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  car           Car?
  bookings      Booking[]
  invoices      DriverInvoice[]
  verificationCode DriverVerificationCode?
}

/** In-app / API alerts for new Viator bookings (populated by POST /viator/inbox/check). */
model ViatorAlert {
  id              String    @id @default(uuid())
  viatorReference String    @unique @map("viator_reference")
  subject         String    @db.VarChar(500)
  pickupDateLabel String    @map("pickup_date_label") @db.VarChar(200)
  receivedAt      DateTime  @map("received_at")
  bookingUuid     String?   @map("booking_uuid")
  payload         Json
  dismissedAt     DateTime? @map("dismissed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([dismissedAt, receivedAt])
  @@map("viator_alerts")
}

model DriverVerificationCode {
  id        String   @id @default(uuid())
  driverId  String   @unique @map("driver_id")
  code      String   @unique @db.VarChar(4)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_verification_codes")
}

model DriverInvoice {
  id                 String              @id @default(uuid())
  driverId           String              @map("driver_id")
  driver             Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  fullName           String              @map("full_name")
  phoneNumber        String              @map("phone_number")
  bookingReference   String              @map("booking_reference")
  pickupDate         DateTime            @map("pickup_date")
  pickupKind         InvoiceAddressKind  @map("pickup_kind")
  pickupAddress      String?             @map("pickup_address")
  pickupAirline      String?             @map("pickup_airline")
  pickupFlightNo     String?             @map("pickup_flight_no")
  dropoffKind        InvoiceAddressKind  @map("dropoff_kind")
  dropoffAddress     String?             @map("dropoff_address")
  dropoffAirline     String?             @map("dropoff_airline")
  dropoffFlightNo    String?             @map("dropoff_flight_no")
  priceAmount        Decimal             @map("price_amount") @db.Decimal(12, 2)
  taxRate            Decimal             @default(0.10) @map("tax_rate") @db.Decimal(8, 6)
  taxAmount          Decimal             @map("tax_amount") @db.Decimal(12, 2)
  totalAmount        Decimal             @map("total_amount") @db.Decimal(12, 2)
  sourceBookingUuid  String?             @map("source_booking_uuid")
  childSeatsSummary  String?             @map("child_seats_summary") @db.VarChar(500)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([driverId, createdAt])
  @@map("driver_invoices")
}

model Car {
  id        String @id @default(uuid())
  driverId  String @unique
  carName   String
  carNumber String @unique
  capacity  Int
  driver    Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Booking {
  id                String   @id @default(uuid())
  uuid              String   @unique @default(uuid())
  bookingReference  String   @unique @map("booking_reference")
  userId            String
  driverId          String?
  customerName    String?  @map("customer_name")
  customerEmail   String?  @map("customer_email")
  customerPhone   String?  @map("customer_phone")
  flightNumber    String?  @map("flight_number")
  returnTime      DateTime? @map("return_time")
  pickupLocation  Json
  dropoffLocation Json
  scheduledTime   DateTime
  price           Float
  status          String
  luggageCount       Int
  passengerCount     Int
  infantCarrierCount Int @default(0)
  childSeatCount     Int @default(0)
  boosterCount       Int @default(0)
  note               String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  driver          Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  /** Set when status becomes `completed`; used to sort past bookings (newest completion first). */
  completedAt     DateTime? @map("completed_at")
  /** Soft delete (trash). Null = active. Purged in batches via POST /bookings/trash/purge. */
  deletedAt       DateTime? @map("deleted_at")

  @@index([deletedAt])
}
